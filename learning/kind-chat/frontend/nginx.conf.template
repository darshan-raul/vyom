server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 64k;
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:8000;
        proxy_connect_timeout 5s;
        proxy_read_timeout 70s;
        proxy_send_timeout 10s;
    }
    location / { try_files $uri $uri/ /index.html; }
    access_log off;
}
