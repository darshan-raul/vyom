  "cards": [
    {
      "dot": "emerald",
      "title": "Checks before an answer is passed on",
      "items": [
        "The reply proposes no further tool call",
        "finish is stop, text is non-empty and at most 4000 chars",
        "Every [n] refers to an item that was collected",
        "If evidence was sent, at least one [n] is cited"
      ]
    },
    {
      "dot": "rose",
      "title": "What a stop returns",
      "items": [
        "HTTP 200 with outcome and a fixed limitation text, never a guess",
        "Evidence that was collected is still returned",
        "no_tool_used names the one namespace Vyom can read"
      ]
    },
    {
      "dot": "amber",
      "title": "Limits per question",
      "items": [
        "Question 1 to 500 chars; one tool call (extra calls are not made)",
        "At most 50 items shown to the model; the rest are counted",
        "60 s for the whole graph; at most 5 graph steps"
      ]
    },
    {
      "dot": "slate",
      "title": "Usable evidence",
      "items": [
        "complete, zero or partial",
        "denied and missing end the question at collect"
      ]
    }
  ]
