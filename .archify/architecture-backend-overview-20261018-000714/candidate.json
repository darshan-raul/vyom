  "cards": [
    {
      "dot": "cyan",
      "title": "Two paths, one evidence shape",
      "items": [
        "Chat: the model proposes a read, McpHost makes it through the MCP server",
        "Pods page: PodCollector reads the API directly, with no model and no MCP",
        "Both end in build_evidence, so IDs, time, coverage and state mean the same"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "The browser sends only a question: extra fields are rejected (HTTP 422)",
        "Scope (connection, namespace) comes from operator config, never the request",
        "Each credential is a file: or env: reference, read fresh on every use"
      ]
    },
    {
      "dot": "amber",
      "title": "Three identities",
      "items": [
        "vyom-api: may only call the MCP endpoint (token audience vyom-mcp)",
        "kubernetes-mcp: the MCP server's own SA, list pods in demo",
        "vyom-collector: the direct path's own SA, list pods in demo"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn here",
      "items": [
        "Telemetry: see the telemetry diagram",
        "GET /api/agent and /api/health report config only and call nothing",
        "McpHost.discover is used only by scripts/mcp_live_check.py",
        "On dev the backend runs on the laptop; MCP is reached by port-forward 127.0.0.1:18443"
      ]
    }
  ]
