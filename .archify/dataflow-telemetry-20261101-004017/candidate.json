 "cards": [
  {
   "dot": "rose",
   "title": "Never recorded",
   "items": [
    "Questions, answers, prompts, tool bodies",
    "Headers, URL queries, exception messages (type only)",
    "Free text from mcp, httpx, openai, langchain, langgraph loggers"
   ]
  },
  {
   "dot": "cyan",
   "title": "One trace_id joins them",
   "items": [
    "Log lines carry trace_id and span_id of the current span",
    "POST /api/chat returns trace_id so a question can be found in Loki and Tempo"
   ]
  },
  {
   "dot": "amber",
   "title": "Bounded on purpose",
   "items": [
    "Metric labels: route templates, configured server/tool/model IDs, fixed outcomes",
    "A tool name the model made up is labelled unlisted",
    "Span queue of 512, dropped when full: an outage never slows a request",
    "Inventory operations (record_collection, resolve_citation, sweep) carry no resource names or IDs"
   ]
  },
  {
   "dot": "slate",
   "title": "Profiles",
   "items": [
    "none (default): /metrics exists, nothing scrapes it, no spans exported",
    "metrics: ServiceMonitor, Prometheus scrapes every 30 s",
    "full: also OTLP to Alloy \u2192 Tempo and pod logs to Loki"
   ]
  }
 ]
