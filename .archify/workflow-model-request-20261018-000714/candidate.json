  "cards": [
    {
      "dot": "rose",
      "title": "Error kinds (provider text is never used)",
      "items": [
        "401/403 auth, 402 quota, 429 rate_limited, 408/504 timeout",
        "5xx or no connection: unavailable; other 4xx: rejected",
        "Body over 256 KiB: oversized; not an AIMessage: invalid_response",
        "In the graph every ModelError ends the question as model_unavailable"
      ]
    },
    {
      "dot": "amber",
      "title": "What the caller cannot change",
      "items": [
        "Endpoint, model and key come from operator config",
        "Only https base_url without credentials, query or fragment is accepted",
        "Output capped at 1024 tokens"
      ]
    },
    {
      "dot": "cyan",
      "title": "Telemetry, once per request",
      "items": [
        "The finally block records ok or the error kind, every time",
        "Tokens only as the provider reported them; none reported is counted as unavailable, not zero",
        "LangSmith export is switched off; no prompt or reply is recorded"
      ]
    }
  ]
