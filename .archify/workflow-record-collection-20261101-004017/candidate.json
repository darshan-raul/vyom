 "cards": [
  {
   "dot": "cyan",
   "title": "Out-of-order safe",
   "items": [
    "A resource or edge updates only when this run is at least as new as stored state and newer than any removal",
    "An older run's observation is still stored, but it changes no edge"
   ]
  },
  {
   "dot": "amber",
   "title": "Ownership (KINV02)",
   "items": [
    "Edge owner \u2192 owned only if the controller is stored and not removed before this run",
    "Any other current owner of the object is superseded",
    "Controller not stored yet: no edge until a later sweep"
   ]
  },
  {
   "dot": "rose",
   "title": "Absence needs proof",
   "items": [
    "Only a complete, untruncated, error-free scan whose items all have UIDs marks the unseen absent",
    "Within the scan's own kind and namespace; failed or partial scans remove nothing"
   ]
  },
  {
   "dot": "slate",
   "title": "Atomic",
   "items": [
    "Run, resources, edges, observations, removals and pruning commit together or not at all"
   ]
  }
 ]
