  "cards": [
    {
      "dot": "rose",
      "title": "Config is checked at load, then frozen",
      "items": [
        "Every credential is a file: or env: reference; a pasted value is rejected without being echoed",
        "MCP URLs must be http(s) without user, query or fragment; http needs allow_cleartext",
        "Model and Kubernetes API URLs must be https; server ids unique"
      ]
    },
    {
      "dot": "amber",
      "title": "What is built only if configured",
      "items": [
        "ChatAgent: a model block, an MCP server and at least one enabled, reviewed tool",
        "PodCollector: a kubernetes block",
        "Missing parts never fall back to something else: the route says not configured"
      ]
    },
    {
      "dot": "slate",
      "title": "Always present",
      "items": [
        "GET /api/health: liveness only, checks nothing else",
        "GET /metrics, request middleware and FastAPI spans from telemetry.instrument"
      ]
    }
  ]
