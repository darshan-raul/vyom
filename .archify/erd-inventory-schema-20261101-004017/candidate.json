 "cards": [
  {
   "dot": "cyan",
   "title": "Composite keys",
   "items": [
    "Each fk shown on one column is really (workspace_id, column): a row can only reference its own workspace",
    "resources is unique on (workspace_id, connection_id, kind, native_uid)",
    "relationships is unique on (workspace_id, source_id, target_id, type)"
   ]
  },
  {
   "dot": "amber",
   "title": "Identity and absence",
   "items": [
    "A recreated object has a new UID, so a new resources row with no inherited edges",
    "removed_at is set only by a complete, untruncated, error-free scan whose items all had UIDs"
   ]
  },
  {
   "dot": "slate",
   "title": "Retention",
   "items": [
    "Up to 500 unreferenced runs per (connection, kind, namespace) are kept; runs referenced by resources or relationships are never pruned",
    "collection_health keeps no run IDs because runs are pruned"
   ]
  },
  {
   "dot": "rose",
   "title": "Fixed values",
   "items": [
    "connections.provider is 'kubernetes'; cluster_uid can never change",
    "collection_runs.state: complete, zero, partial, denied, missing",
    "lease expires_at is computed on the database clock"
   ]
  }
 ]
}