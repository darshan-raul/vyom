  "cards": [
    {
      "dot": "amber",
      "title": "Decision order",
      "items": [
        "1. A blocking error and no items: denied if any error is a refusal, else missing",
        "2. Not complete (cut, failed part-way, or the source said so): partial",
        "3. Items: complete",
        "4. Otherwise: zero"
      ]
    },
    {
      "dot": "rose",
      "title": "Refusal vs breakage",
      "items": [
        "denied: tool_not_allowed, scope_violation, auth, forbidden",
        "missing: unavailable, timeout, protocol, schema_mismatch, oversized, invalid_output, upstream_error",
        "truncated alone is not blocking; it only makes the result partial"
      ]
    },
    {
      "dot": "cyan",
      "title": "Stale is decided by the reader",
      "items": [
        "state_at(now, max_age) turns complete, zero or partial into stale when too old",
        "denied and missing never become stale"
      ]
    },
    {
      "dot": "slate",
      "title": "Always recorded",
      "items": [
        "A random ev_ id, source (path, workspace, connection, cluster, namespace)",
        "collected_at, coverage (complete, returned, truncated) and fixed error messages"
      ]
    }
  ]
