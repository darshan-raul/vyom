  "cards": [
    {
      "dot": "rose",
      "title": "Every failure is still evidence",
      "items": [
        "Each stop raises an internal failure with one fixed kind",
        "call() catches it and passes the kind to build_evidence",
        "denied: tool_not_allowed, scope_violation, auth, forbidden",
        "missing: every other kind, when no items came back"
      ]
    },
    {
      "dot": "amber",
      "title": "What the model can and cannot set",
      "items": [
        "It names a tool id and labelSelector only",
        "namespace is hidden from the model and filled from the trusted context",
        "Repeating the trusted namespace is allowed; any other value is scope_violation"
      ]
    },
    {
      "dot": "cyan",
      "title": "Per-session limits",
      "items": [
        "Connect 5 s + call 15 s under one deadline",
        "Response body capped at 256 KiB; a 401/403 marks the session as auth",
        "No session, token or schema outlives the call"
      ]
    },
    {
      "dot": "slate",
      "title": "Telemetry",
      "items": [
        "One span mcp.client.call, one metric and one log line per call",
        "Unknown tool names are labelled unlisted"
      ]
    }
  ]
