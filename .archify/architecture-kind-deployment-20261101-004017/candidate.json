 "cards": [
  {
   "dot": "cyan",
   "title": "Three read identities",
   "items": [
    "vyom-collector: lists Pods, Deployments, ReplicaSets in demo (sweep + pods view)",
    "kubernetes-mcp: lists Pods in demo for the agent",
    "vyom-api SA: may only call the MCP endpoint; no Kubernetes reads"
   ]
  },
  {
   "dot": "amber",
   "title": "Nothing exposed",
   "items": [
    "Every Service is ClusterIP; no Ingress",
    "The UI is reached only through scripts/vyom-forward.sh on 127.0.0.1"
   ]
  },
  {
   "dot": "rose",
   "title": "Credentials as files",
   "items": [
    "Model key, database URL, MCP and collector tokens are mounted files, never env values or chart values"
   ]
  },
  {
   "dot": "slate",
   "title": "Optional",
   "items": [
    "Prometheus scrape (ServiceMonitor) and OTLP to Alloy/Tempo with VYOM_TELEMETRY=metrics or full"
   ]
  }
