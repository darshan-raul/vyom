   "dot": "cyan",
   "title": "Secrets never in values",
   "items": [
    "MCP TLS cert generated once into .local/mcp-tls (90 days)",
    "Model key from OPENROUTER_API_KEY or .local/model-api-key",
    "Postgres password generated once into .local/postgres-password; Secret holds password and url"
   ]
