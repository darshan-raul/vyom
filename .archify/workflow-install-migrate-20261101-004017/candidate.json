  {
   "dot": "amber",
   "title": "Migrations are controlled",
   "items": [
    "Never on API startup: a Job from the suspended vyom-migrate CronJob",
    "Advisory lock, one transaction per file, checksum refuses edited migrations"
   ]
  },
  {
   "dot": "rose",
   "title": "Profiles",
   "items": [
    "VYOM_TELEMETRY none (default), metrics or full; metrics/full need Prometheus CRDs first",
